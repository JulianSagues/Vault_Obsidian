formulas:
  Sin título: ""
views:
  - type: cards
    name: Tabla
    filters:
      and:
        - file.ext == "base"
        - file.inFolder("Materias")
        - '!file.path.contains("Notas")'
        - '!file.path.contains("Material")'
        - file.basename != "Materias"
        - or:
            - file.basename == "2do"
            - file.basename == "3ro"
            - file.basename == "4to"
            - file.basename == "Finales"
    order:
      - file.name
    cardSize: 240
    imageAspectRatio: 0.25
