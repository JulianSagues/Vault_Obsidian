# Economía

filters:
  and:
    - note["base"] == link("Economía.base")
properties:
  file.name:
    displayName: Tema
  Tipo de Archivo:
    displayName: Tipo de Archivo
  Blocked by:
    displayName: Blocked by
  Archivos Adjuntos:
    displayName: Archivos Adjuntos
  Fecha:
    displayName: Fecha
  Material de Estudio:
    displayName: Material de Estudio
  Sub-item:
    displayName: Sub-item
  Blocking:
    displayName: Blocking
  Parent item:
    displayName: Parent item
  Categoria:
    displayName: Categoria
  AI summary:
    displayName: AI summary
  AI keywords:
    displayName: AI keywords
  AI translation:
    displayName: AI translation
  Custom AI autofill:
    displayName: Custom AI autofill
  Google Drive File:
    displayName: Google Drive File
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Tipo de Archivo
      - Blocked by
      - Archivos Adjuntos
      - Fecha
      - Material de Estudio
      - Sub-item
      - Blocking
      - Parent item
      - Categoria
      - AI summary
      - AI keywords
      - AI translation
      - Custom AI autofill
      - Google Drive File
