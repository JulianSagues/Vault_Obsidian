# Probabilidad y Estadística

filters:
  and:
    - note["base"] == link("Probabilidad y Estadística.base")
properties:
  file.name:
    displayName: Tema
  Tipo de Archivo:
    displayName: Tipo de Archivo
  Fecha:
    displayName: Fecha
  Archivos Adjuntos:
    displayName: Archivos Adjuntos
  Sub-item:
    displayName: Sub-item
  Blocking:
    displayName: Blocking
  Material de Estudio:
    displayName: Material de Estudio
  Parent item:
    displayName: Parent item
  Categoria:
    displayName: Categoria
  Blocked by:
    displayName: Blocked by
views:
  - type: table
    name: Table View
    order:
      - file.name
      - Tipo de Archivo
      - Fecha
      - Archivos Adjuntos
      - Sub-item
      - Blocking
      - Material de Estudio
      - Parent item
      - Categoria
      - Blocked by
